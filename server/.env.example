# Server Configuration
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/freelanceflow?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL (comma-separated if multiple, e.g., http://localhost:5173,https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173
